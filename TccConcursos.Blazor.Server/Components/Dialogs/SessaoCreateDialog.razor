@using MudBlazor
@using TccConcursos.Blazor.Server.Services
@inject ConcursosApi Api

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Nova sessão</MudText>

        <MudTextField @bind-Value="inicioStr"
                      Label="Início"
                      Variant="Variant.Outlined"
                      InputType="InputType.DateTimeLocal"
                      Required="true"
                      RequiredError="Informe o início"
                      Class="mt-2" />

        <MudTextField @bind-Value="fimStr"
                      Label="Fim"
                      Variant="Variant.Outlined"
                      InputType="InputType.DateTimeLocal"
                      Required="true"
                      RequiredError="Informe o fim"
                      Class="mt-4" />

        <MudSelect T="int" @bind-Value="tipo"
                   Label="Tipo"
                   Variant="Variant.Outlined"
                   Class="mt-4">
            <MudSelectItem Value="1">Teoria</MudSelectItem>
            <MudSelectItem Value="2">Revisão</MudSelectItem>
            <MudSelectItem Value="3">Questões</MudSelectItem>
        </MudSelect>

        <MudTextField @bind-Value="questoesTotal"
                      Label="Questões (total)"
                      Variant="Variant.Outlined"
                      InputType="InputType.Number"
                      Class="mt-4" />

        <MudTextField @bind-Value="questoesAcertos"
                      Label="Acertos"
                      Variant="Variant.Outlined"
                      InputType="InputType.Number"
                      Class="mt-2" />

        @if (!string.IsNullOrWhiteSpace(erro))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@erro</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="Salvar" Disabled="isBusy" Color="Color.Primary" Variant="Variant.Filled">
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid TopicoId { get; set; }

    private string? inicioStr;
    private string? fimStr;
    private int tipo = 1;
    private int? questoesTotal;
    private int? questoesAcertos;

    private bool isBusy;
    private string? erro;

    private void Cancelar() => MudDialog.Cancel();

    private static bool TryParseLocalDateTime(string? value, out DateTime dt)
    {
        // datetime-local vem como "2026-02-05T14:30"
        return DateTime.TryParse(value, out dt);
    }

    private async Task Salvar()
    {
        erro = null;

        if (!TryParseLocalDateTime(inicioStr, out var inicio))
        {
            erro = "Informe um início válido.";
            return;
        }

        if (!TryParseLocalDateTime(fimStr, out var fim))
        {
            erro = "Informe um fim válido.";
            return;
        }

        isBusy = true;

        try
        {
            var req = new ConcursosApi.CreateSessaoEstudoRequest(
                Inicio: inicio,
                Fim: fim,
                Tipo: tipo,
                QuestoesTotal: questoesTotal,
                QuestoesAcertos: questoesAcertos
            );

            var created = await Api.CreateSessaoAsync(TopicoId, req);
            MudDialog.Close(DialogResult.Ok(created));
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}