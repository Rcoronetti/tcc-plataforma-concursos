@using MudBlazor
@inject TccConcursos.Blazor.Server.Services.ConcursosApi Api
@using TccConcursos.Blazor.Server.Services


<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Editar concurso</MudText>

        <MudTextField @bind-Value="nome"
                      Label="Nome"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="Informe o nome" />

        <MudDatePicker @bind-Date="dataProva"
                       Label="Data da prova (opcional)"
                       Variant="Variant.Outlined"
                       DateFormat="dd/MM/yyyy"
                       Class="mt-4" />

        @if (!string.IsNullOrWhiteSpace(erro))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@erro</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="Salvar" Disabled="isBusy" Color="Color.Primary" Variant="Variant.Filled">
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ConcursosApi.ConcursoDto Concurso { get; set; } = default!;

    private string nome = string.Empty;
    private DateTime? dataProva;
    private bool isBusy;
    private string? erro;

    protected override void OnParametersSet()
    {
        nome = Concurso.Nome;
        dataProva = Concurso.DataProva?.ToDateTime(TimeOnly.MinValue);
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Salvar()
    {
        erro = null;

        if (string.IsNullOrWhiteSpace(nome))
        {
            erro = "Informe o nome do concurso.";
            return;
        }

        isBusy = true;

        try
        {
            DateOnly? data = dataProva is null
                ? null
                : DateOnly.FromDateTime(dataProva.Value);

            var updated = await Api.UpdateConcursoAsync(Concurso.Id, new ConcursosApi.UpdateConcursoRequest(nome.Trim(), data));
            MudDialog.Close(DialogResult.Ok(updated));
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}