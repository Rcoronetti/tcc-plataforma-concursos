@using MudBlazor
@using TccConcursos.Blazor.Server.Services
@inject ConcursosApi Api

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Editar sessão</MudText>

        <MudTextField @bind-Value="inicioStr"
                      Label="Início"
                      Variant="Variant.Outlined"
                      InputType="InputType.DateTimeLocal"
                      Required="true"
                      RequiredError="Informe o início"
                      Class="mt-2" />

        <MudTextField @bind-Value="fimStr"
                      Label="Fim"
                      Variant="Variant.Outlined"
                      InputType="InputType.DateTimeLocal"
                      Required="true"
                      RequiredError="Informe o fim"
                      Class="mt-4" />

        <MudSelect T="int" @bind-Value="tipo" @bind-Value:after="() => OnTipoChanged()"
                   Label="Tipo"
                   Variant="Variant.Outlined"
                   Class="mt-4">
            <MudSelectItem Value="1">Teoria</MudSelectItem>
            <MudSelectItem Value="2">Revisão</MudSelectItem>
            <MudSelectItem Value="3">Questões</MudSelectItem>
        </MudSelect>

        <MudNumericField T="int?" @bind-Value="questoesTotal"
                         Label="Questões (total)"
                         Variant="Variant.Outlined"
                         Disabled="@(tipo != 3)"
                         Min="0"
                         Class="mt-4" />

        <MudNumericField T="int?" @bind-Value="questoesAcertos"
                         Label="Acertos"
                         Variant="Variant.Outlined"
                         Disabled="@(tipo != 3)"
                         Min="0"
                         Class="mt-2" />

        @if (!string.IsNullOrWhiteSpace(erro))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@erro</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="Salvar" Disabled="isBusy" Color="Color.Primary" Variant="Variant.Filled">
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ConcursosApi.SessaoEstudoDto Sessao { get; set; } = default!;

    private string? inicioStr;
    private string? fimStr;
    private int tipo;
    private int? questoesTotal;
    private int? questoesAcertos;

    private bool isBusy;
    private string? erro;

    protected override void OnParametersSet()
    {
        // datetime-local espera "yyyy-MM-ddTHH:mm"
        inicioStr = Sessao.Inicio.ToString("yyyy-MM-ddTHH:mm");
        fimStr = Sessao.Fim.ToString("yyyy-MM-ddTHH:mm");
        tipo = Sessao.Tipo;
        questoesTotal = Sessao.QuestoesTotal;
        questoesAcertos = Sessao.QuestoesAcertos;
    }

    private void Cancelar() => MudDialog.Cancel();

    private static bool TryParseLocalDateTime(string? value, out DateTime dt)
        => DateTime.TryParse(value, out dt);

    private void NormalizeNumbers()
    {
        if (tipo != 3)
        {
            questoesTotal = null;
            questoesAcertos = null;
        }
    }

    private bool Validate(DateTime inicio, DateTime fim)
    {
        if (fim <= inicio)
        {
            erro = "O fim deve ser maior que o início.";
            return false;
        }

        if (tipo == 3)
        {
            if (questoesTotal is null || questoesTotal <= 0)
            {
                erro = "Informe o total de questões (maior que 0).";
                return false;
            }

            if (questoesAcertos is null || questoesAcertos < 0)
            {
                erro = "Informe os acertos (0 ou maior).";
                return false;
            }

            if (questoesAcertos > questoesTotal)
            {
                erro = "Acertos não pode ser maior que o total de questões.";
                return false;
            }
        }

        return true;
    }

    private async Task Salvar()
    {
        erro = null;

        if (!TryParseLocalDateTime(inicioStr, out var inicio))
        {
            erro = "Informe um início válido.";
            return;
        }

        if (!TryParseLocalDateTime(fimStr, out var fim))
        {
            erro = "Informe um fim válido.";
            return;
        }

        NormalizeNumbers();

        if (!Validate(inicio, fim))
            return;

        isBusy = true;

        try
        {
            var req = new ConcursosApi.UpdateSessaoEstudoRequest(
                Inicio: inicio,
                Fim: fim,
                Tipo: tipo,
                QuestoesTotal: questoesTotal,
                QuestoesAcertos: questoesAcertos
            );

            var updated = await Api.UpdateSessaoAsync(Sessao.TopicoId, Sessao.Id, req);
            MudDialog.Close(DialogResult.Ok(updated));
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void OnTipoChanged()
    {
        Console.WriteLine($"Tipo mudou para {tipo}");

        if (tipo != 3)
        {
            questoesTotal = null;
            questoesAcertos = null;
        }

        StateHasChanged();
    }
}