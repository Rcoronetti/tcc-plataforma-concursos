@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using TccConcursos.Blazor.Server.Services
@implements IDisposable
@inject Server.Services.NavigationContext NavCtx
@inject AppAuthenticationStateProvider AuthProvider

<MudNavMenu Dense="true">
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/dashboard"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>

            <MudDivider Class="my-2" />

            <MudNavLink Href="/concursos"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.EmojiEvents">
                Concursos
            </MudNavLink>

            @if (NavCtx.ConcursoId is not null)
            {
                <MudDivider Class="my-2" />

                <MudNavLink Href="@($"/concursos/{NavCtx.ConcursoId}/disciplinas")"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.School">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="nav-row">
                        <MudText>Disciplinas</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Class="nav-chip">
                            @NavCtx.ConcursoNome
                        </MudChip>
                    </MudStack>
                </MudNavLink>
            }

            @if (NavCtx.ConcursoId is not null && NavCtx.DisciplinaId is not null)
            {
                <MudNavLink Href="@($"/concursos/{NavCtx.ConcursoId}/disciplinas/{NavCtx.DisciplinaId}/topicos")"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Bookmarks">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="nav-row">
                        <MudText>Tópicos</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Class="nav-chip">
                            @NavCtx.DisciplinaNome
                        </MudChip>
                    </MudStack>
                </MudNavLink>
            }

            @if (NavCtx.ConcursoId is not null && NavCtx.DisciplinaId is not null && NavCtx.TopicoId is not null)
            {
                <MudNavLink Href="@($"/concursos/{NavCtx.ConcursoId}/disciplinas/{NavCtx.DisciplinaId}/topicos/{NavCtx.TopicoId}/sessoes")"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Timer">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="nav-row">
                        <MudText>Sessões</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Class="nav-chip">
                            @NavCtx.TopicoNome
                        </MudChip>
                    </MudStack>
                </MudNavLink>
            }


            <MudNavLink Href="/configuracao-usuario"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.ManageAccounts">
                Configuração do usuário
            </MudNavLink>

            <MudDivider Class="my-2" />
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Logout"
                       OnClick="Sair"
                       Class="w-100">
                Logout
            </MudButton>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/login"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Login">
                Login
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

<style>
    .nav-row {
        width: 100%;
        overflow: hidden;
        display: flex;
        align-items: center;
    }

        .nav-row .mud-typography {
            flex-shrink: 0;
        }

    .nav-chip {
        border-color: rgba(255,255,255,.35) !important;
        color: rgba(255,255,255,.92) !important;
        background-color: rgba(255,255,255,.06) !important;
        max-width: 999px;
        min-width: 80px;
        height: 22px;
        display: inline-flex;
        align-items: center;
        flex: 1 1 auto;
        min-width: 0;
    }

        .nav-chip .mud-chip-content {
            display: inline-flex;
            align-items: center;
            line-height: 1;
            padding-top: 0;
            padding-bottom: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            width: 100%;
        }
</style>

@code {
    protected override void OnInitialized()
        => NavCtx.OnChange += StateHasChanged;

    public void Dispose()
        => NavCtx.OnChange -= StateHasChanged;

    private void Sair()
    {
        AuthProvider.Logout();
    }
}
