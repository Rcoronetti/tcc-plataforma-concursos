@using MudBlazor
@using TccConcursos.Blazor.Server.Services
@implements IDisposable
@inject TccConcursos.Blazor.Server.Services.NavigationContext NavCtx

<MudNavMenu Dense="true">

    <MudNavLink Href="/concursos"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.EmojiEvents">
        Concursos
    </MudNavLink>

    @if (NavCtx.ConcursoId is not null)
    {
        <MudDivider Class="my-2" />

        <MudNavLink Href="@($"/concursos/{NavCtx.ConcursoId}/disciplinas")"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.School">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText>Disciplinas</MudText>
                <MudText Typo="Typo.caption" Class="nav-context">
                    @NavCtx.ConcursoNome
                </MudText>
            </MudStack>
        </MudNavLink>
    }

    @if (NavCtx.ConcursoId is not null && NavCtx.DisciplinaId is not null)
    {
        <MudNavLink Href="@($"/concursos/{NavCtx.ConcursoId}/disciplinas/{NavCtx.DisciplinaId}/topicos")"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.Bookmarks">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText>Tópicos</MudText>
                <MudText Typo="Typo.caption" Class="nav-context">
                    @NavCtx.DisciplinaNome
                </MudText>
            </MudStack>
        </MudNavLink>
    }

    @if (NavCtx.ConcursoId is not null && NavCtx.DisciplinaId is not null && NavCtx.TopicoId is not null)
    {
        <MudNavLink Href="@($"/concursos/{NavCtx.ConcursoId}/disciplinas/{NavCtx.DisciplinaId}/topicos/{NavCtx.TopicoId}/sessoes")"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.Timer">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText>Sessões</MudText>
                <MudText Typo="Typo.caption" Class="nav-context">
                    @NavCtx.TopicoNome
                </MudText>
            </MudStack>
        </MudNavLink>
    }

</MudNavMenu>

<style>
    .nav-context {
        opacity: .80;
        margin-left: 4px;
    }
</style>

@code {
    protected override void OnInitialized()
        => NavCtx.OnChange += StateHasChanged;

    public void Dispose()
        => NavCtx.OnChange -= StateHasChanged;
}