@page "/concursos/{ConcursoId:guid}/disciplinas"
@rendermode InteractiveServer
@using MudBlazor
@using TccConcursos.Blazor.Server.Services
@using TccConcursos.Blazor.Server.Components.Dialogs
@inject ConcursosApi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
    <MudButton Variant="Variant.Outlined" OnClick="Voltar">
        Voltar
    </MudButton>

    <MudText Typo="Typo.h5">Disciplinas</MudText>
</MudStack>

<MudStack Row="true" Spacing="2" Class="mb-4">
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="AbrirNovo">
        Nova disciplina
    </MudButton>

    <MudButton Variant="Variant.Outlined" OnClick="Carregar">
        Recarregar
    </MudButton>
</MudStack>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <MudAlert Severity="Severity.Error">@loadError</MudAlert>
}
else if (disciplinas.Count == 0)
{
    <MudAlert Severity="Severity.Info">Nenhuma disciplina cadastrada.</MudAlert>
}
else
{
    <MudTable Items="disciplinas" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nome">@context.Nome</MudTd>
            <MudTd DataLabel="Ações">
                <MudButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           OnClick="() => AbrirEditar(context)">
                    Editar
                </MudButton>
                <MudButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Error"
                           OnClick="() => ConfirmarExcluir(context)">
                    Excluir
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public Guid ConcursoId { get; set; }

    private List<ConcursosApi.DisciplinaDto> disciplinas = new();
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await Carregar();
    }

    private void Voltar() => Nav.NavigateTo("/concursos");

    private async Task Carregar()
    {
        loadError = null;
        isLoading = true;

        try
        {
            disciplinas = await Api.GetDisciplinasAsync(ConcursoId);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AbrirNovo()
    {
        var parameters = new DialogParameters { ["ConcursoId"] = ConcursoId };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<DisciplinaCreateDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await Carregar();
            Snackbar.Add("Disciplina criada com sucesso!", Severity.Success);
        }
    }

    private async Task AbrirEditar(ConcursosApi.DisciplinaDto item)
    {
        var parameters = new DialogParameters { ["Disciplina"] = item };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<DisciplinaEditDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await Carregar();
            Snackbar.Add("Disciplina atualizada com sucesso!", Severity.Success);
        }
    }

    private async Task ConfirmarExcluir(ConcursosApi.DisciplinaDto item)
    {
        var result = await DialogService.ShowMessageBox(
            "Confirmar exclusão",
            $"Tem certeza que deseja excluir a disciplina '{item.Nome}'?",
            yesText: "Excluir",
            cancelText: "Cancelar");

        if (result == true)
        {
            try
            {
                var sucesso = await Api.DeleteDisciplinaAsync(item.ConcursoId, item.Id);
                if (sucesso)
                {
                    await Carregar();
                    Snackbar.Add("Disciplina excluída com sucesso!", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Erro ao excluir disciplina.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
            }
        }
    }
}