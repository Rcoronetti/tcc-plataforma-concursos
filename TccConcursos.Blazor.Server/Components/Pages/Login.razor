@page "/login"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using TccConcursos.Blazor.Server.Services
@inject AppAuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-10">
    <MudCard Elevation="6">
        <MudCardHeader>
            <MudText Typo="Typo.h5">Entrar na plataforma</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudStack Spacing="2">
                <MudTextField @bind-Value="model.Login"
                              Label="E-mail ou CPF"
                              Variant="Variant.Outlined"
                              Required="true"
                              Immediate="true" />

                <MudTextField @bind-Value="model.Senha"
                              Label="Senha"
                              Variant="Variant.Outlined"
                              Required="true"
                              InputType="InputType.Password"
                              Immediate="true" />

                @if (!string.IsNullOrWhiteSpace(erro))
                {
                    <MudAlert Severity="Severity.Error">@erro</MudAlert>
                }

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="Entrar"
                           FullWidth="true">
                    Entrar
                </MudButton>

                <MudDivider Class="my-2" />

                <MudText Typo="Typo.body2" Align="Align.Center">
                    Primeiro acesso?
                    <MudLink Href="/cadastro">Criar cadastro básico</MudLink>
                </MudText>
            </MudStack>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private readonly LoginModel model = new();
    private string? erro;

    private void Entrar()
    {
        erro = null;

        if (!AuthProvider.Login(model.Login, model.Senha))
        {
            erro = "Credenciais inválidas. Faça seu cadastro se for o primeiro acesso.";
            return;
        }

        Nav.NavigateTo("/dashboard", forceLoad: false);
    }

    private sealed class LoginModel
    {
        public string Login { get; set; } = string.Empty;
        public string Senha { get; set; } = string.Empty;
    }
}
