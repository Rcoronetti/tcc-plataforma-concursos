@page "/concursos/{ConcursoId:guid}/disciplinas/{DisciplinaId:guid}/topicos/{TopicoId:guid}/sessoes"
@rendermode InteractiveServer
@using MudBlazor
@using TccConcursos.Blazor.Server.Services
@using TccConcursos.Blazor.Server.Components.Dialogs
@inject ConcursosApi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
    <MudButton Variant="Variant.Outlined" OnClick="Voltar">
        Voltar
    </MudButton>

    <MudStack Spacing="0">
        <MudText Typo="Typo.h5">Sessões de Estudo</MudText>
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
            Concurso — @(concursoNome ?? "Carregando...") • Disciplina — @(disciplinaNome ?? "Carregando...") • Tópico — @(topicoNome ?? "Carregando...")
        </MudText>
    </MudStack>
</MudStack>

<MudStack Row="true" Spacing="2" Class="mb-4">
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="AbrirNovo">
        Nova sessão
    </MudButton>

    <MudButton Variant="Variant.Outlined" OnClick="Carregar">
        Recarregar
    </MudButton>
</MudStack>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <MudAlert Severity="Severity.Error">@loadError</MudAlert>
}
else if (sessoes.Count == 0)
{
    <MudAlert Severity="Severity.Info">Nenhuma sessão cadastrada.</MudAlert>
}
else
{
    <MudTable Items="sessoes" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Início</MudTh>
            <MudTh>Fim</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Questões</MudTh>
            <MudTh>Acertos</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Início">@context.Inicio.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Fim">@context.Fim.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Tipo">@TipoToText(context.Tipo)</MudTd>
            <MudTd DataLabel="Questões">@((context.QuestoesTotal?.ToString()) ?? "-")</MudTd>
            <MudTd DataLabel="Acertos">@((context.QuestoesAcertos?.ToString()) ?? "-")</MudTd>
            <MudTd DataLabel="Ações">
                <MudButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           OnClick="() => AbrirEditar(context)">
                    Editar
                </MudButton>
                <MudButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Error"
                           OnClick="() => ConfirmarExcluir(context)">
                    Excluir
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public Guid ConcursoId { get; set; }
    [Parameter] public Guid DisciplinaId { get; set; }
    [Parameter] public Guid TopicoId { get; set; }

    private List<ConcursosApi.SessaoEstudoDto> sessoes = new();
    private bool isLoading = true;
    private string? loadError;

    private string? concursoNome;
    private string? disciplinaNome;
    private string? topicoNome;

    protected override async Task OnInitializedAsync()
    {
        await CarregarCabecalho();
        await Carregar();
    }

    private async Task CarregarCabecalho()
    {
        try
        {
            var c = await Api.GetConcursoAsync(ConcursoId);
            concursoNome = c?.Nome;

            var d = await Api.GetDisciplinaAsync(ConcursoId, DisciplinaId);
            disciplinaNome = d?.Nome;

            var t = await Api.GetTopicoAsync(DisciplinaId, TopicoId);
            topicoNome = t?.Nome;
        }
        catch
        {
            concursoNome = null;
            disciplinaNome = null;
            topicoNome = null;
        }
    }

    private void Voltar()
        => Nav.NavigateTo($"/concursos/{ConcursoId}/disciplinas/{DisciplinaId}/topicos");

    private async Task Carregar()
    {
        loadError = null;
        isLoading = true;

        try
        {
            sessoes = await Api.GetSessoesAsync(TopicoId);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string TipoToText(int tipo) => tipo switch
    {
        1 => "Teoria",
        2 => "Revisão",
        3 => "Questões",
        _ => $"Tipo {tipo}"
    };

    private async Task AbrirNovo()
    {
        var parameters = new DialogParameters { ["TopicoId"] = TopicoId };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<SessaoCreateDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await Carregar();
            Snackbar.Add("Sessão criada com sucesso!", Severity.Success);
        }
    }

    private async Task AbrirEditar(ConcursosApi.SessaoEstudoDto item)
    {
        var parameters = new DialogParameters { ["Sessao"] = item };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<SessaoEditDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await Carregar();
            Snackbar.Add("Sessão atualizada com sucesso!", Severity.Success);
        }
    }

    private async Task ConfirmarExcluir(ConcursosApi.SessaoEstudoDto item)
    {
        var result = await DialogService.ShowMessageBox(
            "Confirmar exclusão",
            $"Tem certeza que deseja excluir esta sessão ({item.Inicio:dd/MM/yyyy HH:mm} - {item.Fim:dd/MM/yyyy HH:mm})?",
            yesText: "Excluir",
            cancelText: "Cancelar");

        if (result == true)
        {
            try
            {
                var sucesso = await Api.DeleteSessaoAsync(item.TopicoId, item.Id);
                if (sucesso)
                {
                    await Carregar();
                    Snackbar.Add("Sessão excluída com sucesso!", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Erro ao excluir sessão.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
            }
        }
    }
}