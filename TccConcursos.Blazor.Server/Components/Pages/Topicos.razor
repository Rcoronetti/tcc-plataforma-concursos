@page "/concursos/{ConcursoId:guid}/disciplinas/{DisciplinaId:guid}/topicos"
@rendermode InteractiveServer
@using MudBlazor
@using TccConcursos.Blazor.Server.Services
@using TccConcursos.Blazor.Server.Components.Dialogs
@inject ConcursosApi Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
    <MudButton Variant="Variant.Outlined" OnClick="Voltar">
        Voltar
    </MudButton>

    <MudStack Spacing="0">
        <MudText Typo="Typo.h5">
            Tópicos — @(disciplinaNome ?? "Carregando...")
        </MudText>
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
            Concurso — @(concursoNome ?? "Carregando...")
        </MudText>
    </MudStack>
</MudStack>

<MudStack Row="true" Spacing="2" Class="mb-4">
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="AbrirNovo">
        Novo tópico
    </MudButton>

    <MudButton Variant="Variant.Outlined" OnClick="Carregar">
        Recarregar
    </MudButton>
</MudStack>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <MudAlert Severity="Severity.Error">@loadError</MudAlert>
}
else if (topicos.Count == 0)
{
    <MudAlert Severity="Severity.Info">Nenhum tópico cadastrado.</MudAlert>
}
else
{
    <MudTable Items="topicos" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nome">@context.Nome</MudTd>
            <MudTd DataLabel="Ações">
                <MudButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           OnClick="() => AbrirEditar(context)">
                    Editar
                </MudButton>
                <MudButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Variant="Variant.Text"
                           Color="Color.Error"
                           OnClick="() => ConfirmarExcluir(context)">
                    Excluir
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public Guid ConcursoId { get; set; }
    [Parameter] public Guid DisciplinaId { get; set; }

    private List<ConcursosApi.TopicoDto> topicos = new();
    private bool isLoading = true;
    private string? loadError;
    private string? disciplinaNome;
    private string? concursoNome;

    protected override async Task OnInitializedAsync()
    {
        await CarregarCabecalho();
        await Carregar();
    }

    private async Task CarregarCabecalho()
    {
        try
        {
            var d = await Api.GetDisciplinaAsync(ConcursoId, DisciplinaId);
            disciplinaNome = d?.Nome;

            var c = await Api.GetConcursoAsync(ConcursoId);
            concursoNome = c?.Nome;
        }
        catch
        {
            disciplinaNome = null;
            concursoNome = null;
        }
    }

    private void Voltar()
        => Nav.NavigateTo($"/concursos/{ConcursoId}/disciplinas");

    private async Task Carregar()
    {
        loadError = null;
        isLoading = true;

        try
        {
            topicos = await Api.GetTopicosAsync(DisciplinaId);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AbrirNovo()
    {
        var parameters = new DialogParameters { ["DisciplinaId"] = DisciplinaId };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<TopicoCreateDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await Carregar();
            Snackbar.Add("Tópico criado com sucesso!", Severity.Success);
        }
    }

    private async Task AbrirEditar(ConcursosApi.TopicoDto item)
    {
        var parameters = new DialogParameters { ["Topico"] = item };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<TopicoEditDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await Carregar();
            Snackbar.Add("Tópico atualizado com sucesso!", Severity.Success);
        }
    }

    private async Task ConfirmarExcluir(ConcursosApi.TopicoDto item)
    {
        var result = await DialogService.ShowMessageBox(
            "Confirmar exclusão",
            $"Tem certeza que deseja excluir o tópico '{item.Nome}'?",
            yesText: "Excluir",
            cancelText: "Cancelar");

        if (result == true)
        {
            try
            {
                var sucesso = await Api.DeleteTopicoAsync(item.DisciplinaId, item.Id);
                if (sucesso)
                {
                    await Carregar();
                    Snackbar.Add("Tópico excluído com sucesso!", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Erro ao excluir tópico.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
            }
        }
    }
}